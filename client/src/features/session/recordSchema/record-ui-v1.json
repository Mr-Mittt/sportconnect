{
  "version": 1,
  "tones": [
    "success",
    "warning",
    "danger",
    "accent"
  ],
  "COMPETITIVE": {
    "defaultStyle": "horizontal",
    "styles": {
      "horizontal": {
        "config": {
          "winnerAlign": {
            "enum": [
              "LEFT",
              "RIGHT"
            ],
            "default": "LEFT"
          },
          "winnerTone": {
            "enum": "tones",
            "default": "success"
          },
          "loserTone": {
            "enum": "tones",
            "default": "warning"
          }
        }
      },
      "vertical": {
        "config": {
          "winnerAlign": {
            "enum": [
              "TOP",
              "BOTTOM"
            ],
            "default": "TOP"
          },
          "winnerTone": {
            "enum": "tones",
            "default": "success"
          },
          "loserTone": {
            "enum": "tones",
            "default": "warning"
          }
        }
      }
    },
    "scoreboard": {
      "columns": [
        "games",
        "wins",
        "losses",
        "winRate",
        "winDiff",
        "scoreFor",
        "scoreAgainst",
        "scoreDiff"
      ],
      "statIds": {
        "games": 1,
        "wins": 2,
        "losses": 3,
        "scoreFor": 4,
        "scoreAgainst": 5,
        "winRate": 6,
        "winDiff": 7,
        "scoreDiff": 8
      },
      "defaultColumns": [
        "games",
        "wins",
        "losses"
      ],
      "sortKeys": [
        "games",
        "wins",
        "losses",
        "winRate",
        "winDiff",
        "scoreFor",
        "scoreAgainst",
        "scoreDiff",
        "name"
      ],
      "defaultSort": [
        {
          "by": "wins",
          "dir": "DESC"
        },
        {
          "by": "winDiff",
          "dir": "DESC"
        },
        {
          "by": "games",
          "dir": "ASC"
        },
        {
          "by": "name",
          "dir": "ASC"
        }
      ]
    }
  }
}

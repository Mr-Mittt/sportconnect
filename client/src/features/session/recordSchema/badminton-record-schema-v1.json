{
  "version": 1,
  "maxRecords": 50,
  "record": {
    "data": {
      "type": "COMPETITIVE",
      "playersPerSide": {
        "min": 1,
        "max": 2
      },
      "score": {
        "slot": [
          {
            "required": true,
            "title": {
              "vi": "Điểm",
              "en": "Point"
            },
            "rule": ">0"
          }
        ]
      }
    },
    "UI": {
      "id": "horizontal",
      "config": {
        "winnerAlign": "LEFT"
      }
    },
    "scoreboard": {
      "enabled": true,
      "columns": [
        "games",
        "wins",
        "losses",
        "winDiff"
      ],
      "sort": [
        {
          "by": "games",
          "dir": "DESC"
        },
        {
          "by": "wins",
          "dir": "DESC"
        },
        {
          "by": "winDiff",
          "dir": "ASC"
        },
        {
          "by": "name",
          "dir": "ASC"
        }
      ]
    }
  }
}

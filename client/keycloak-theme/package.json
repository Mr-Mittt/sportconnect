{
  "name": "sportconnect-keycloak-theme",
  "private": true,
  "version": "0.0.1",
  "description": "AUTH-15: Keycloak-hosted login pages in the SportHub look (Keycloakify 11). Shares the client's tokens and primitives through the '@' alias.",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build-keycloak-theme": "pnpm run build && keycloakify build",
    "storybook": "storybook dev -p 6007 --disable-telemetry",
    "build-storybook": "node -e \"require('node:fs').rmSync('storybook-static',{recursive:true,force:true})\" && storybook build --disable-telemetry",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "keycloakify": "^11.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/react-vite": "^10.4.6",
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "storybook": "^10.4.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}

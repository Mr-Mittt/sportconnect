# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets here. This is a dev-convenience
# stand-in for exporting these in your shell every session (see CLAUDE.md's
# "Dependency philosophy" — this is not a config file the way application.yml is,
# just a place to put `export` statements once).
#
# godotenv (loaded in internal/config/config.go) never overrides a variable
# that's already set in your real shell environment — so if you've exported
# something yourself, that value wins over whatever's in this file.

# --- Required — the service refuses to start without these ---

# This service's own Postgres database (never the monolith's). Matches
# infra/docker-compose.dev.yml's Postgres credentials + the sportconnect_chat_dev
# database seeded by infra/scripts/init-chat-db.sql.
CHAT_DATABASE_URL=postgres://postgres:sa@localhost:5432/sportconnect_chat_dev

# Must be byte-identical to the monolith's app.jwt.secret. The monolith runs under the "dev"
# Spring profile by default, and server/src/main/resources/application-dev.yml overrides this
# to a DIFFERENT literal than the base application.yml's own fallback — this value matches
# application-dev.yml's, which is what's actually active under ./gradlew :server:bootRun.
JWT_SECRET=dev-secret-key-for-development-only-change-in-production-min-256-bits

# Must be byte-identical to the monolith's app.internal-service-secret. Matches the dev-only
# literal baked into application-dev.yml — no export needed on the monolith side either, as
# long as it's running under the default "dev" profile.
INTERNAL_SERVICE_SECRET=some-shared-dev-secret

# --- Optional — sensible defaults if omitted ---

# REDIS_ADDR=localhost:6379
# MONOLITH_BASE_URL=http://localhost:8080
# CHAT_HTTP_ADDR=:8081
# CHAT_CORS_ALLOWED_ORIGIN=http://localhost:5173

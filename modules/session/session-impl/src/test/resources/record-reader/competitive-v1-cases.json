{
  "description": "SESSION-53: one shared fixture for the COMPETITIVE (v1) record reader. The server's CompetitiveRecordReaderFixtureSpec runs every case; the client's Vitest runs the same file (CLIENT-SESSION-58) so the two readers cannot drift. A case names a schema, a record's data, and what the reader must say. Player ids are fixed UUIDs: p1 = 11111111-1111-1111-1111-111111111111, p2 = 2222..., p3 = 3333..., p4 = 4444... (the literal ids are used below).",
  "schemas": {
    "badminton": {
      "version": 1,
      "maxRecords": 50,
      "record": {
        "data": {
          "type": "COMPETITIVE",
          "playersPerSide": { "min": 1, "max": 2 },
          "score": { "slot": [ { "required": true, "rule": ">=0&<=30" } ] }
        }
      }
    },
    "football": {
      "version": 1,
      "maxRecords": 100,
      "record": {
        "data": {
          "type": "COMPETITIVE",
          "playersPerSide": { "min": 1, "max": 11 },
          "score": { "slot": [ { "required": true, "rule": ">=0" } ] }
        },
        "statistics": {
          "metrics": [ { "key": "scoreFor", "aggregate": "MAX" }, { "key": "scoreAgainst", "aggregate": "MIN" } ],
          "derived": [ { "key": "goalDiff", "formula": "scoreFor-scoreAgainst" } ]
        }
      }
    },
    "noScore": {
      "version": 1,
      "record": { "data": { "type": "COMPETITIVE", "playersPerSide": { "min": 1, "max": 2 } } }
    }
  },
  "cases": [
    {
      "id": "doubles-complete-first-ahead",
      "schema": "badminton",
      "data": { "teams": [
        { "players": ["11111111-1111-1111-1111-111111111111", "22222222-2222-2222-2222-222222222222"], "scores": [21] },
        { "players": ["33333333-3333-3333-3333-333333333333", "44444444-4444-4444-4444-444444444444"], "scores": [18] } ] },
      "expect": { "valid": true, "rankable": true, "notRankableReason": null,
        "players": ["11111111-1111-1111-1111-111111111111", "22222222-2222-2222-2222-222222222222", "33333333-3333-3333-3333-333333333333", "44444444-4444-4444-4444-444444444444"] }
    },
    {
      "id": "singles-complete-first-ahead",
      "schema": "badminton",
      "data": { "teams": [
        { "players": ["11111111-1111-1111-1111-111111111111"], "scores": [21] },
        { "players": ["33333333-3333-3333-3333-333333333333"], "scores": [0] } ] },
      "expect": { "valid": true, "rankable": true, "notRankableReason": null,
        "players": ["11111111-1111-1111-1111-111111111111", "33333333-3333-3333-3333-333333333333"] }
    },
    {
      "id": "planned-game-null-scores",
      "schema": "badminton",

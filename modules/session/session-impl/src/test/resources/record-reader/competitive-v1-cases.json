        { "players": ["33333333-3333-3333-3333-333333333333"], "scores": [null] } ] },
      "expect": { "valid": true, "rankable": false, "notRankableReason": "NO_SCORE",
        "players": ["11111111-1111-1111-1111-111111111111", "33333333-3333-3333-3333-333333333333"] }
    },
    {

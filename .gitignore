# Tools / IDE
.classpath
.project
.settings
.idea
.vscode
.sdkmanrc

# Build tools
**/.gradle/

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Build directories
**/build
**/bin
**/out
**/target
**/node_modules
**/lib
# **/lib is for Java dependency/build dirs — it must NOT swallow client source.
# (Caused CI-only TS2307s: shared/lib was never committed while local builds passed.)
!client/src/shared/lib
!client/src/shared/lib/**
**/.npm

# Log files
*.log
*.gz
*.tgz

# Environment files — real secrets never committed; each service's own
# .env.example (tracked) documents the keys instead. Currently only
# services/chat/ uses one (see its CLAUDE.md).
**/.env
!**/.env.example

# Other
**/*.bak
*.txt
.DS_Store

### Jenkins ###
.config/
.npmrc
.docker/
.m2/
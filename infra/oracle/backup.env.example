# Copy to /etc/sportconnect/backup.env on the box (root-owned, chmod 600 is not needed: there are no secrets here,
# the box authenticates to Object Storage with its instance principal). Read by sportconnect-backup.service.

# required: the private Object Storage bucket (created in the Oracle console, see the runbook)
BACKUP_BUCKET=<bucket-name>

# optional: the Object Storage namespace; looked up with the OCI CLI when unset
#OCI_NAMESPACE=<namespace>

# optional overrides (defaults shown)
#BACKUP_DIR=/home/ubuntu/backups
#PG_CONTAINER=sportconnect-dev-postgres-1
#PG_USER=postgres
#DATABASES="sportconnect_dev sportconnect_chat_dev keycloak_dev"
#LOCAL_KEEP_DAYS=2

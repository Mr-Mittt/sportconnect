# INFRA-12 sandbox: environment file of the chat service (sc-chat). Copy to ~/web/chat.env on the box, `chmod 600`,
# and fill in the <placeholders>. The real file is never committed. Variables: services/chat/internal/config/config.go
CHAT_DATABASE_URL=postgres://postgres:<dev default today (sa)>@postgres:5432/sportconnect_chat_dev?sslmode=disable
# Defaults to localhost:6379 if missing, which does not work in a container (found during INFRA-12).
REDIS_ADDR=redis:6379
KEYCLOAK_ISSUER_URI=https://auth.yoursport.vn/realms/sportconnect
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/sportconnect/protocol/openid-connect/certs
MONOLITH_BASE_URL=http://sc-server:8080
CHAT_CORS_ALLOWED_ORIGIN=https://yoursport.vn
# Byte-identical to INTERNAL_SERVICE_SECRET in server.env
INTERNAL_SERVICE_SECRET=<openssl rand -hex 24>

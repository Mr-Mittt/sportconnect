# INFRA-12 sandbox reverse proxy (Caddy), copied from the Oracle box on 2026-10-26.
# Runbook: infra/documentation/MVP/INFRA-12_ORACLE_SANDBOX_RUNBOOK.md
#
# Caddy gets and renews the Let's Encrypt certificates itself (keep /data in a volume, see run-containers.sh).
# Container names (sc-server, sc-chat, keycloak) resolve on the Compose network `sportconnect-dev_default`.

# The realm only allows https://yoursport.vn as a sign-in redirect, so www goes to the apex.
www.yoursport.vn {
	redir https://yoursport.vn{uri} permanent
}

yoursport.vn {
	encode gzip zstd

	# chat has no /api/chat prefix of its own (same rewrite as the Vite dev proxy in client/vite.config.ts)
	handle /api/chat/* {
		uri strip_prefix /api/chat
		reverse_proxy sc-chat:8090
	}
	handle /api/* {
		reverse_proxy sc-server:8080
	}
	handle /ws* {
		reverse_proxy sc-server:8080
	}
	handle /images/* {
		reverse_proxy sc-server:8080
	}
	# Everything else is the static client; unknown paths fall back to index.html (single-page app).
	# Note: /actuator, /internal and Swagger are NOT proxied and so fall through to index.html. Keep it that way.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

auth.yoursport.vn {
	# The admin console and the master realm are not reachable from the internet. Use an SSH tunnel (see the
	# runbook, "Keycloak admin console"). The master realm has its own frontendUrl for that.
	@admin path /admin /admin/* /realms/master /realms/master/*
	respond @admin 403
	# Typing the auth host by hand lands on the app's login page instead of a 403.
	redir / https://yoursport.vn/login 302
	reverse_proxy keycloak:8080
}

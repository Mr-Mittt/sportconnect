# INFRA-14: passwords of the backing services on the production box. Copy to ~/web/stack.env, `chmod 600`, replace every
# <placeholder>. The real file is never committed. Read by `docker compose --env-file` (start-stack.sh) and by
# scripts/rotate-credentials.sh. The values of an application's own copy (server.env, chat.env) must equal the ones here;
# infra/oracle/SECRETS.md lists which file holds which value and how to rotate it.
#
# Every password: 16 to 128 characters of A-Z a-z 0-9 _ - ; `openssl rand -hex 24` gives one. Do not reuse a value.

# the Postgres superuser; used by backups (through the container's local socket) and by an admin, never by an application
POSTGRES_PASSWORD=<openssl rand -hex 24>
# one least-privilege role per service, created by rotate-credentials.sh postgres
SC_APP_DB_PASSWORD=<openssl rand -hex 24>
SC_CHAT_DB_PASSWORD=<openssl rand -hex 24>
KC_DB_PASSWORD=<openssl rand -hex 24>

# RabbitMQ: the one application user (AMQP and STOMP); lowercase letters, digits and _, never guest
RABBITMQ_USERNAME=<for example sc_mq>
RABBITMQ_PASSWORD=<openssl rand -hex 24>

REDIS_PASSWORD=<openssl rand -hex 24>

# INFRA-12 sandbox: environment file of the `prod`-profile server (sc-server). Copy to ~/web/server.env on the box,
# `chmod 600`, and fill in the <placeholders>. The real file is never committed.
# Which variables the profile requires: server/src/main/resources/application-prod.yml (no defaults there).
SPRING_PROFILE=prod

# Backing services, by Compose service name (the server container joins sportconnect-dev_default)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sportconnect_dev
# INFRA-14: the app's own role (owns sportconnect_dev), created by scripts/rotate-credentials.sh. Same value as SC_APP_DB_PASSWORD in stack.env.
DB_USERNAME=sc_app
DB_PASSWORD=<openssl rand -hex 24>
REDIS_HOST=redis
REDIS_PORT=6379
# same value as REDIS_PASSWORD in stack.env
REDIS_PASSWORD=<openssl rand -hex 24>
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# same values as RABBITMQ_USERNAME / RABBITMQ_PASSWORD in stack.env (the STOMP relay logs in with them too); never guest
RABBITMQ_USERNAME=<lowercase name, for example sc_mq>
RABBITMQ_PASSWORD=<openssl rand -hex 24>
STOMP_RELAY_HOST=rabbitmq
STOMP_RELAY_PORT=61613

# Keycloak. The issuer is the PUBLIC address (it is what tokens carry); the back-channel calls use the container name.
KEYCLOAK_ISSUER_URI=https://auth.yoursport.vn/realms/sportconnect
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/sportconnect/protocol/openid-connect/certs
KEYCLOAK_REDIRECT_URI=https://yoursport.vn/auth/callback
KEYCLOAK_TOKEN_URI=http://keycloak:8080/realms/sportconnect/protocol/openid-connect/token
KEYCLOAK_LOGOUT_URI=http://keycloak:8080/realms/sportconnect/protocol/openid-connect/logout
KEYCLOAK_ADMIN_URI=http://keycloak:8080/admin/realms/sportconnect
# Random value; the SAME value is set on the realm client `sportconnect-credentials` by scripts/set-credentials-client-secret.sh
KEYCLOAK_CREDENTIALS_CLIENT_SECRET=<openssl rand -hex 24>
# Random value, byte-identical in chat.env. NOTE: under the `dev` profile this variable is ignored (application-dev.yml
# hard-codes some-shared-dev-secret), which is why this file sets SPRING_PROFILE=prod.
INTERNAL_SERVICE_SECRET=<openssl rand -hex 24>

CORS_ORIGINS=https://yoursport.vn

# Mail through Brevo (INFRA-11, INFRA-12 point 10). Port 587 because Oracle blocks outbound 25.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<the SMTP login Brevo shows, not the key>
MAIL_PASSWORD=<the Brevo SMTP key>
EMAIL_FROM=noreply@yoursport.vn
# Mail is not part of /actuator/health in the prod profile (INFRA-11), so empty MAIL_* does not make the server unhealthy.
